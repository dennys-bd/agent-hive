{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": { "includes": ["**", "!**/handoff"] },
  "formatter": { "enabled": false },
  "assist": { "enabled": false },
  "css": { "parser": { "tailwindDirectives": true } },
  "linter": {
    "enabled": true,
    "rules": { "preset": "recommended" }
  },
  "overrides": [
    {
      "includes": ["test/**"],
      "linter": { "rules": { "style": { "noNonNullAssertion": "off" } } }
    },
    // #158: a task's disk, processes and ptys go through its Machine (src/machine.ts), and #927 its paths. The overrides below turn the rule off for the
    // files allowed a direct import: the host's own, and the ones 7.2 to 7.5 have still to move, each node deleting its own lines
    {
      "includes": ["src/**", "!src/ui/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "node:fs": "A task's disk is its machine's: go through Machine (src/machine.ts, #158). A host-only file is listed in biome.jsonc.",
                  "node:fs/promises": "A task's disk is its machine's: go through Machine (src/machine.ts, #158). A host-only file is listed in biome.jsonc.",
                  "node:child_process": "A task's processes are its machine's: go through Machine (src/machine.ts, #158). A host-only file is listed in biome.jsonc.",
                  "fs": "Import node:fs, which is restricted the same way (#158).",
                  "fs/promises": "Import node:fs/promises, which is restricted the same way (#158).",
                  "child_process": "Import node:child_process, which is restricted the same way (#158).",
                  "node:path": "A task's paths are its machine's: join and compare them with machine.paths (src/machine.ts, #927). A host-only file is listed in biome.jsonc.",
                  "path": "A task's paths are its machine's: join and compare them with machine.paths (src/machine.ts, #927). A host-only file is listed in biome.jsonc.",
                  "node:path/posix": "A task's paths are its machine's: join and compare them with machine.paths (src/machine.ts, #927). A host-only file is listed in biome.jsonc.",
                  "path/posix": "A task's paths are its machine's: join and compare them with machine.paths (src/machine.ts, #927). A host-only file is listed in biome.jsonc.",
                  "node:path/win32": "A task's paths are its machine's: join and compare them with machine.paths (src/machine.ts, #927). A host-only file is listed in biome.jsonc.",
                  "path/win32": "A task's paths are its machine's: join and compare them with machine.paths (src/machine.ts, #927). A host-only file is listed in biome.jsonc."
                }
              }
            }
          }
        }
      }
    },
    // #927: node:path allowed, node:fs and child_process still restricted. An override's paths replace the base rule's, so this one restates
    // the fs ones without node:path. Host-only for paths, permanent: nothing in them is a task's disk. Pending: each node deletes its group
    {
      "includes": [
        "src/home.ts", "src/main.ts", "src/config-nested.ts", "src/benchmark-guards.ts", "src/server-benchmark-*.ts", "src/memory.ts",
        "src/mcp-settings.ts", "src/platform-commands.ts", "src/lsp-process.ts", "src/lsp-host.ts", // lsp: until a distro has language servers
        // 2.2 (#932): workspace calls on the workspace's machine
        "src/mcp-conventions.ts"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "node:fs": "A task's disk is its machine's: go through Machine (src/machine.ts, #158). A host-only file is listed in biome.jsonc.",
                  "node:fs/promises": "A task's disk is its machine's: go through Machine (src/machine.ts, #158). A host-only file is listed in biome.jsonc.",
                  "node:child_process": "A task's processes are its machine's: go through Machine (src/machine.ts, #158). A host-only file is listed in biome.jsonc.",
                  "fs": "Import node:fs, which is restricted the same way (#158).",
                  "fs/promises": "Import node:fs/promises, which is restricted the same way (#158).",
                  "child_process": "Import node:child_process, which is restricted the same way (#158)."
                }
              }
            }
          }
        }
      }
    },
    // Host-only, permanent: what is not a task's (config, state, credentials, logs, the Hive's home, the daemon) and the machine's own code
    {
      "includes": [
        "src/agents/**", "!src/agents/claude-transcript.ts", "!src/agents/codex-transcript.ts", "!src/agents/copilot-transcript.ts", "!src/agents/copilot-home.ts", "!src/agents/jsonl.ts", // #161, #928: the transcripts are the machine's
        "src/benchmark/**", "src/read-model/**", "src/sources/**",
        "src/*-store.ts", "src/config.ts", "src/config-machines.ts", "src/credentials.ts", "src/github-token.ts", "src/daemon*.ts", "src/hive.ts", "src/home-*.ts",
        "src/log.ts", "src/facts.ts", "src/editor-*.ts", "src/server-editor-install.ts", "src/plugin-render.ts", "src/plugin-changelog.ts",
        "src/launch-options.ts",
        "src/custom-*.ts", "src/command-shim.ts", "src/shim.ts", "src/shell-init.ts", "src/exec-path.ts", "src/posix-shell.ts",
        "src/kill-tree.ts", "src/pty-host.ts", "src/spawn.ts", "src/spawn-internal.ts", "src/terminal-files.ts", "src/terminal-wire.ts",
        "src/headless-run.ts", "src/worker-lsp.ts", "src/server-memory.ts", "src/settings-save.ts", "src/replace-file.ts",
        "src/keep-awake.ts", "src/locale-env.ts", "src/main-window-bounds.ts", "src/item-sources.ts", "src/items-catalogue.ts",
        "src/machine.ts", "src/machine-local*.ts", "src/machine-run.ts", "src/host-fs.ts",
        "src/wsl/**" // #927: the host side of a distro, wsl.exe and its pipe; #941: the helper that runs in the distro, on its own disk
      ],
      "linter": { "rules": { "style": { "noRestrictedImports": "off" } } }
    },
    // Pending: files a sibling node still has to move; each node deletes its own group
    {
      "includes": [
        // unowned, 7.5 (#882): nested repos, design parts and exit cwd on the machine
        "src/worktree-nested.ts", "src/worktree-stranded.ts", "src/nested-check.ts", "src/server-nested.ts",
        "src/design-parts.ts", "src/server-exit.ts",
        // src/server.ts: exists' access and the config write, the host's own; #161 moved only its call sites, and no node owns the file
        "src/server.ts"
      ],
      "linter": { "rules": { "style": { "noRestrictedImports": "off" } } }
    }
  ]
}

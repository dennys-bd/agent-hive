#!/bin/sh
# The Hive's command shim (#800), rendered for each first word of a line with a Command Semaphore into <home>/command-shims/<word>, first
# on every pty's PATH. It asks the daemon before the real command runs (#798's answers): run, or no answer at all, runs it as typed; run
# <semaphore> runs it and gives the permit back when it ends; refused tells the agent it is in line and stops; wait (a terminal's) stays in
# place until its turn (#801). A Hive down or stuck costs at most 2 s, never the command.
# Windows runs the same shim under Git's sh.exe (#806).
word=__HIVE_COMMAND__
language=__HIVE_LANGUAGE__ # the Hive's, rendered on every boot and save (#801): en or pt
platform=__HIVE_PLATFORM__ # #806: the Hive's process.platform, rendered as the word is; every win32 branch reads it, never uname
acquire_now= # set only by the wait's r, never taken from the env
# On win32 the .cmd twin starts this file as %~dp0<word>, a path with backslashes (#806): cut at either, or the folder is lost
if [ "$platform" = win32 ]; then
  case $0 in *[/\\]*) self_dir=${0%[/\\]*} ;; *) self_dir=. ;; esac
else
  case $0 in */*) self_dir=${0%/*} ;; *) self_dir=. ;; esac
fi
self_dir=$(CDPATH= cd -- "$self_dir" && pwd)

# Every command-shim folder this command has passed through, its own first, in the env of whatever it starts: with two on PATH (a Hive
# started from a Hive pty) each shim would otherwise find the other's and exec it forever.
HIVE_COMMAND_SHIM_DIRS=$self_dir${HIVE_COMMAND_SHIM_DIRS:+:$HIVE_COMMAND_SHIM_DIRS}
export HIVE_COMMAND_SHIM_DIRS

# #806 decision 3: on win32, after the word as given (an MSYS script, or an .exe through MSYS's own suffix), the names PATHEXT's runnable
# extensions make, in its order, the set namesOf in src/exec-path.ts runs; lowercased, since Windows' file system ignores the case and a
# test folder elsewhere does not. A .vbs or .js on PATHEXT is nothing sh can start. :-joined, for on_path's IFS
runnable_exts() (
  IFS=';'
  set -f
  exts=
  for ext in ${PATHEXT:-.COM;.EXE;.BAT;.CMD}; do
    case "$ext" in
      .[Cc][Oo][Mm]) exts=$exts:.com ;;
      .[Ee][Xx][Ee]) exts=$exts:.exe ;;
      .[Bb][Aa][Tt]) exts=$exts:.bat ;;
      .[Cc][Mm][Dd]) exts=$exts:.cmd ;;
    esac
  done
  printf '%s' "${exts#:}"
)
exts=
if [ "$platform" = win32 ]; then exts=$(runnable_exts); fi

# The first regular executable <dir>/<name> on PATH outside those folders that is not this file under another name (a link to the shim
# elsewhere on PATH would exec itself forever), as the agent shim's real_cli; -f, since the shell's own lookup skips a folder of that name.
# The folders are compared with -ef (#806): on Windows one folder has two spellings (an 8.3 name, another case), and a missed one would
# run this shim's own .cmd twin. Copied, not sourced, since a helper would be one more file every shim must find. A subshell, so IFS and
# set -f stay its own. Builtins only: the word could name any external command.
on_path() (
  IFS=:
  set -f
  for dir in $PATH; do
    for shims in $HIVE_COMMAND_SHIM_DIRS; do [ "$dir" -ef "$shims" ] && continue 2; done
    for ext in '' $exts; do
      file=$dir/$1$ext
      [ "$file" -ef "$0" ] && continue
      [ -f "$file" ] && [ -x "$file" ] && { printf '%s\n' "$file"; exit 0; }
    done
  done
  exit 1
)

real=$(on_path "$word") || { echo "$word: not found on PATH" >&2; exit 127; }

# #806 decision 4: cmd.exe expands %…% even in quotes and ends its line at a break, so no quoting carries them to a .cmd or .bat. Refused
# as cmdRunner in src/exec-path.ts refuses them, by position and never by value (an argument may carry a secret), and never passed on
# changed, so outside a Hive pty too. Before any acquire, so no permit or place is taken for a command that cannot start. A NUL never
# reaches an argv; only the message names it. 126: found, but cannot run
refuse_for_cmd() {
  case "$real" in *.[Cc][Mm][Dd]|*.[Bb][Aa][Tt]) ;; *) return 0 ;; esac
  cr=$(printf '\r')
  lf='
'
  n=0
  for arg in "$@"; do
    n=$((n + 1))
    case "$arg" in
      *%*|*"$cr"*|*"$lf"*)
        printf 'hive: %s: cmd.exe cannot pass argument %s (it has %%, a line break or NUL)\n' "$word" "$n" >&2
        exit 126 ;;
    esac
  done
}
if [ "$platform" = win32 ]; then refuse_for_cmd "$@"; fi

# Not in a Hive pty: as typed
[ -n "${HIVE_PTY_ID:-}" ] && [ -n "${HIVE_PORT:-}" ] && [ -n "${HIVE_SECRET_FILE:-}" ] || exec "$real" "$@"

# The shim's own curl, found as the real binary is: with a semaphore on curl, a bare curl here would be this shim again, forever. None:
# as with no answer
curl=$(on_path curl) || exec "$real" "$@"

# #806 decision 5: the daemon probes pid with process.kill(pid, 0) to free a permit whose holder died (#798), and an MSYS pid is no Windows
# pid: on win32 the shell's own Windows pid, $$ when /proc cannot tell it. In braces, so a missing file is no fatal redirection
shim_pid=$$
if [ "$platform" = win32 ]; then
  winpid=
  { read -r winpid < "/proc/$$/winpid"; } 2>/dev/null
  case "$winpid" in ''|*[!0-9]*) ;; *) shim_pid=$winpid ;; esac
fi

# The argv as a form, one arg field per word, this word first: sh cannot JSON-escape an arg, and curl url-encodes each value whole (#932).
# pid is this shell's (its Windows pid on win32, #806), which the daemon probes to free a permit whose holder died (#798). The secret goes
# as curl's header file, never in an argv (#467), and never through a proxy the env names: the Hive is on loopback. -q first, so no
# ~/.curlrc (a --trace) ever applies. The function's own positional args become curl's, so the user's stay as typed for the exec below.
acquire() {
  for arg in "$@"; do set -- "$@" --data-urlencode "arg=$arg"; shift; done
  "$curl" -q -sf --noproxy '*' -m 2 -X POST "http://127.0.0.1:$HIVE_PORT/hooks/semaphores/acquire" -H "x-hive-pty: $HIVE_PTY_ID" \
    -H @"$HIVE_SECRET_FILE" --data-urlencode "arg=$word" -d "pid=$shim_pid" ${acquire_now:+-d now=true} "$@"
}

# No answer within 2 s, or a non-2xx: as typed. Only the reply's first line counts, read as data and never evaluated
reply=$(acquire "$@") || exec "$real" "$@"
read -r answer name place rest <<EOF
$reply
EOF

# A semaphore's name is one word of [A-Za-z0-9_-] (#796), so the release's JSON needs no escaping; a place is a number. Anything else
# makes an answer this shim does not know, which runs as typed
case "$name" in ''|*[!A-Za-z0-9_-]*) name= ;; esac
case "$place" in ''|*[!0-9]*) place= ;; esac

# Its failure is ignored: the daemon frees a permit whose pid is gone, and a pty's end frees all it holds (#798)
release() {
  "$curl" -q -s --noproxy '*' -m 2 -X POST "http://127.0.0.1:$HIVE_PORT/hooks/semaphores/release" -H "x-hive-pty: $HIVE_PTY_ID" \
    -H @"$HIVE_SECRET_FILE" -H 'content-type: application/json' -d "{\"semaphore\":\"$name\"}" >/dev/null 2>&1
}

# 1st, 2nd, 3rd, 4th; 11th, 12th, 13th; 21st
ordinal() {
  case "$1" in
    *1[123]) printf '%sth' "$1" ;;
    *1) printf '%sst' "$1" ;;
    *2) printf '%snd' "$1" ;;
    *3) printf '%srd' "$1" ;;
    *) printf '%sth' "$1" ;;
  esac
}

# A signal to the shim alone (a shell tool's timeout sends TERM to it) still ends the child and frees the permit at once; SIGKILL is left
# to the daemon's pid check (#798). An INT goes on as TERM: a background child of a non-interactive sh ignores INT, and the ignore survives
# its exec. $!, not child: a trap runs between commands, so $! is set as soon as the child is, and empty before (nothing else here runs in
# the background), with no window where the child runs unknown to the trap. The exit is 128 + the signal the shim got, as a shell reports a
# command a signal ended.
on_signal() {
  trap '' INT TERM HUP
  if [ -n "$!" ]; then
    kill -s "$1" "$!" 2>/dev/null
    wait "$!"
  fi
  release
  exit $((128 + $2))
}

# The real binary as a child, so the shim outlives it to give the permit back. A non-interactive sh gives a background child /dev/null as
# stdin, so fd 3 carries the shim's own; a closed stdin is tried in a subshell first, since a failed exec redirection exits a POSIX shell,
# and the child gets /dev/null instead. Without job control the child stays in the terminal's process group, yet ignores INT and QUIT as
# a background child of a non-interactive sh: a Ctrl-C reaches it only as the TERM the shim's INT trap sends (planning decision 1). The
# traps come first, so no signal finds the child started and the shim unguarded.
run_held() {
  trap 'on_signal TERM 2' INT
  trap 'on_signal TERM 15' TERM
  trap 'on_signal HUP 1' HUP
  if (exec 3<&0) 2>/dev/null; then exec 3<&0; else exec 3</dev/null; fi
  "$real" "$@" <&3 3<&- &
  child=$!
  exec 3<&-
  wait "$child"
  code=$?
  release
  exit "$code"
}

# #801: the wait's one line, in the card's own words (#805); the key is offered only where it is read
wait_line() {
  if [ "$language" = pt ]; then
    printf 'hive: %s aguardando a vez de %s · %sº' "$word" "$name" "$place"
    [ -n "$tty_saved" ] && printf ' · r executa agora'
    printf ' · Ctrl-C sai'
  else
    printf 'hive: %s waiting on %s · place %s' "$word" "$name" "$place"
    [ -n "$tty_saved" ] && printf ' · r runs it now'
    printf ' · Ctrl-C leaves'
  fi
}

# On a TTY stderr the line is rewritten in place; elsewhere (a log) one line per change, never a \r
show_line() { if [ -t 2 ]; then printf '\r\033[K%s' "$(wait_line)" >&2; else printf '%s\n' "$(wait_line)" >&2; fi; }
end_wait() {
  [ -n "$tty_saved" ] && stty "$tty_saved" 2>/dev/null
  tty_saved=
  [ -t 2 ] && printf '\r\033[K' >&2
  :
}

# A Ctrl-C reaches dd or sleep and the shim alike (one foreground group); a TERM to the shim alone waits out the tick, at most 1 s
on_wait_signal() {
  trap '' INT TERM HUP
  end_wait
  release
  exit "$1"
}

# One tick of the wait, 1 s. On a TTY stdin a timed read of one byte (-icanon min 0 time 10) is the clock, and r answers 0; any other key
# is dropped, so a stray Enter never runs over the limit, and sleeps out a second, so a paste or an arrow key is no burst of acquires.
# Elsewhere a sleep, and no key is ever read
tick() {
  if [ -n "$tty_saved" ]; then
    case "$(dd bs=1 count=1 2>/dev/null)" in r|R) return 0 ;; '') return 1 ;; esac
  fi
  sleep 1
  return 1
}

# The terminal's foreground group is the shim's own; ps pads its columns, which the unquoted split drops. No ps: no key
in_foreground() {
  set -- $(ps -o tpgid= -o pgid= -p $$ 2>/dev/null)
  [ $# -eq 2 ] && [ "$1" = "$2" ]
}

# #801: a terminal waits in place by asking again every second (#797: the daemon keeps no connection open). run <name> is its turn, or
# r's now granted above the limit; any other answer, or none, gives the place back and runs as typed, so no place outlives the wait
wait_in_place() {
  trap 'on_wait_signal 130' INT
  trap 'on_wait_signal 143' TERM
  trap 'on_wait_signal 129' HUP
  trap 'on_wait_signal 131' QUIT
  # bash puts its own modes back on a Ctrl-Z and never the job's on fg, so a resumed wait sets its own again
  trap '[ -n "$tty_saved" ] && stty -icanon -echo min 0 time 10 2>/dev/null' CONT
  tty_saved=
  # The key only in the terminal's foreground: from a background job (pnpm test &) stty and dd would stop it on SIGTTOU or SIGTTIN. On
  # win32 MSYS's ps has no tpgid column, so the check is skipped (#806 decision 11). Known ceiling: a background job in Git's bash may stop
  # on the read there; the card's run now (#805) still covers a terminal without the key
  if [ -t 0 ] && { [ "$platform" = win32 ] || in_foreground; }; then
    tty_saved=$(stty -g 2>/dev/null) && stty -icanon -echo min 0 time 10 2>/dev/null || tty_saved=
  fi
  shown=
  while :; do
    [ "$place" = "$shown" ] || { show_line; shown=$place; }
    if tick; then acquire_now=1; else acquire_now=; fi
    reply=$(acquire "$@") || break
    read -r answer next spot rest <<EOF
$reply
EOF
    [ "$next" = "$name" ] || break
    case "$answer:$spot" in
      run:) end_wait; run_held "$@" ;;
      wait:|wait:*[!0-9]*) break ;;
      wait:*) place=$spot ;;
      *) break ;;
    esac
  done
  end_wait
  release
  exec "$real" "$@"
}

case "$answer:${name:+name}:${place:+place}" in
  run::) exec "$real" "$@" ;; # no semaphore on this argv, or a permit this pty already holds: nothing to give back
  run:name:) run_held "$@" ;;
  refused:name:place)
    # #799 tells the agent its turn, so the line says to wait for that rather than retry in a loop. 75 is EX_TEMPFAIL
    printf 'hive: %s refused: the semaphore %s is full and you are %s in line. Do not retry: you will be told when your turn comes.\n' \
      "$word" "$name" "$(ordinal "$place")" >&2
    exit 75 ;;
  wait:name:place) wait_in_place "$@" ;;
esac
exec "$real" "$@"

#!/bin/sh
# The Hive's claude shim (#696): first on every terminal's PATH. A new conversation typed here registers as a free session of the
# terminal's activity, with the Hive's hooks, MCP, plugin and protocol; anything else runs the real claude as typed. A register the Hive
# refuses, or that gets no answer, never blocks the user's command.
self_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)

# The real claude: the first one on PATH outside this directory that is not this file under another name (a link to the shim elsewhere on
# PATH would exec itself forever). A subshell, so IFS and set -f stay its own.
real_claude() (
  IFS=:
  set -f
  for dir in $PATH; do
    [ "$dir" = "$self_dir" ] && continue
    [ "$dir/claude" -ef "$0" ] && continue
    [ -x "$dir/claude" ] && { printf '%s\n' "$dir/claude"; exit 0; }
  done
  exit 1
)

real=$(real_claude) || { echo "claude: not found on PATH" >&2; exit 127; }

# Not in a Hive terminal, a subcommand, or a session the user chose (resume, continue, an id) or no conversation at all: as typed
passthrough() {
  [ -n "${HIVE_PTY_ID:-}" ] && [ -n "${HIVE_PORT:-}" ] && [ -n "${HIVE_SECRET_FILE:-}" ] || return 0
  case "${1:-}" in __HIVE_SUBCOMMANDS__) return 0 ;; esac
  for arg in "$@"; do
    case "$arg" in
      --resume|--resume=*|-r|--continue|-c|--session-id|--session-id=*|-p|--print|-h|--help|-v|--version) return 0 ;;
    esac
  done
  return 1
}

if passthrough "$@"; then exec "$real" "$@"; fi

# The secret goes as curl's header file, never in an argv (#467), and never through a proxy the env names: the Hive is on loopback. 5 s, since a
# register the server took but the shim gave up on leaves a run that never reports its exit.
reply=$(curl -sf --noproxy '*' -m 5 -X POST "http://127.0.0.1:$HIVE_PORT/hooks/terminals/$HIVE_PTY_ID/session" -H @"$HIVE_SECRET_FILE") || exec "$real" "$@"
run_id=$(printf '%s\n' "$reply" | sed -n 1p)
hive_args=$(printf '%s\n' "$reply" | sed -n '2,$p')
case "$run_id" in ''|*[!0-9a-f-]*) exec "$real" "$@" ;; esac

# The Hive's args, one per line (the server refuses an arg holding a line break), read as data and never evaluated: appended after the
# user's, then the user's rotated to the end, so claude gets the Hive's first
user_count=$#
if [ -n "$hive_args" ]; then
  while IFS= read -r arg; do set -- "$@" "$arg"; done <<EOF
$hive_args
EOF
fi
i=0
while [ "$i" -lt "$user_count" ]; do set -- "$@" "$1"; shift; i=$((i + 1)); done
HIVE_PTY_ID=$run_id "$real" "$@"
code=$?
curl -s --noproxy '*' -m 2 -X POST "http://127.0.0.1:$HIVE_PORT/hooks/exit" -H "x-hive-pty: $run_id" -H @"$HIVE_SECRET_FILE" >/dev/null
exit $code

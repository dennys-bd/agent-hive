{
  "name": "agent-hive",
  "version": "0.1.0",
  "private": true,
  "license": "FSL-1.1-ALv2",
  "type": "module",
  "packageManager": "pnpm@10.22.0",
  "main": "dist/src/main.js",
  "bin": {
    "hive": "bin/hive.js"
  },
  "scripts": {
    "build": "tsc && tsc -p src/ui && rm -rf dist/src/ui/assets && vite build",
    "dev": "vite",
    "test": "concurrently --group \"pnpm:test:*\"",
    "test:lint": "biome lint --error-on-warnings",
    "test:types-ui": "tsc -p src/ui",
    "test:node": "tsc && rm -rf dist/src/ui/assets && vite build && node --test \"dist/test/*.test.js\" \"dist/test/agents/*.test.js\" \"dist/test/sources/*.test.js\" \"dist/test/experiment/*.test.js\" \"dist/test/repos/*.test.js\"",
    "test:vitest": "vitest run",
    "lint": "biome lint --error-on-warnings",
    "experiment:snapshot": "pnpm build && node dist/scripts/experiment/snapshot-cli.js",
    "experiment:skills": "pnpm build && node dist/scripts/experiment/run.js",
    "experiment:evaluate": "pnpm build && node dist/scripts/experiment/evaluate.js",
    "start": "pnpm build && node bin/hive.js",
    "run:headless": "pnpm build && node dist/src/run.js",
    "run:test-hive": "pnpm build && node dist/scripts/test-hive.js",
    "run:experiment-a": "pnpm build && node dist/scripts/experiment/preview.js a",
    "run:experiment-b": "pnpm build && node dist/scripts/experiment/preview.js b",
    "seed:test-board": "pnpm build && node dist/scripts/seed-test-board.js",
    "postinstall": "chmod +x node_modules/node-pty/prebuilds/darwin-*/spawn-helper"
  },
  "dependencies": {
    "@iconify-json/vscode-icons": "^1.2.84",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/xterm": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cn": "^0.3.0",
    "express": "^5.1.0",
    "katex": "^0.16.47",
    "lucide-react": "^1.47.0",
    "material-icon-theme": "^5.39.0",
    "mermaid": "^11.17.2",
    "monaco-editor": "^0.52.2",
    "next-themes": "^0.4.6",
    "node-pty": "^1.1.0",
    "overlayscrollbars": "^2.16.0",
    "overlayscrollbars-react": "^0.5.6",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "rehype-slug": "^6.0.0",
    "remark-gemoji": "^8.0.0",
    "remark-gfm": "^4.0.1",
    "remark-github": "^12.0.0",
    "remark-math": "^6.0.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "vscode-icons-js": "^11.6.1",
    "vscode-languageserver-protocol": "^3.18.4",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.3.2",
    "ws": "^8.22.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@playwright/mcp": "^0.0.83",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "10.0.5",
    "electron": "^38.0.0",
    "jsdom": "^30.1.0",
    "playwright": "^1.63.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "node-pty"
    ]
  }
}

{
  "compilerOptions": {
    "target": "es2022",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "lib": ["es2022", "dom"],
    "types": ["node"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "rootDir": ".",
    "outDir": "dist",
    "sourceMap": true,
    "paths": { "@/*": ["./src/ui/*"] }
  },
  "include": ["src/**/*.ts", "test/**/*.ts"],
  "exclude": ["src/ui/**/*.tsx", "src/ui/hooks/**", "src/ui/components/**", "test/ui/**"]
}
